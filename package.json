{
  "name": "argentometro",
  "version": "0.1.0",
  "description": "Indicadores económicos y sociales argentinos comparados entre gestiones presidenciales, con datos de fuentes oficiales y su metodología a la vista.",
  "private": true,
  "license": "MIT",
  "homepage": "https://tomasscally.github.io/argentometro/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomasscally/argentometro.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot": "vite-node scripts/snapshot.ts",
    "cargar-csv": "vite-node scripts/cargar-csv.ts",
    "verificar-series": "vite-node scripts/verificar-series.ts"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^17.11.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  }
}
